Sub PrepareOutputSheets()
   Dim wsP As Worksheet, wsG As Worksheet
   Set wsP = ThisWorkbook.Worksheets(WS_PLAN)
   Set wsG = ThisWorkbook.Worksheets(WS_GANTT)
 
   wsP.Cells.Clear: wsG.Cells.Clear
   PlanRow = 2
 
   wsP.Range("A1:L1").Value = Array("Tarih", "Vardiya", "Baslangic Shift", "Bitis Shift", "Ucak", "Islem", "Konum", "Sure", "Isciler", "Oncelik", "Akis Tipi", "Durum")
   With wsP.Range("A1:L1")
       .Interior.Color = RGB(31, 56, 100)
       .Font.Color = vbWhite
       .Font.Bold = True
       .HorizontalAlignment = xlCenter
   End With
End Sub
 
Sub AddPlan(ucak As String, op As String, loc As String, s As Long, e As Long, workersTxt As String, pr As Long, dueS As Long, flowType As String, doGantt As Boolean)
   Dim ws As Worksheet
   Set ws = ThisWorkbook.Worksheets(WS_PLAN)
 
   ws.Cells(PlanRow, 1).Value = ShiftDate(s)
   ws.Cells(PlanRow, 1).NumberFormat = "dd.mm.yyyy"
   ws.Cells(PlanRow, 2).Value = ShiftCode(s)
   ws.Cells(PlanRow, 3).Value = s
   ws.Cells(PlanRow, 4).Value = e
   ws.Cells(PlanRow, 5).Value = ucak
   ws.Cells(PlanRow, 6).Value = op
   ws.Cells(PlanRow, 7).Value = loc
   ws.Cells(PlanRow, 8).Value = e - s + 1
   ws.Cells(PlanRow, 9).Value = workersTxt
   ws.Cells(PlanRow, 10).Value = pr
   ws.Cells(PlanRow, 11).Value = flowType
   ws.Cells(PlanRow, 12).Value = IIf(e <= dueS, "Zamaninda", "GECIKME RISKI")
 
   If e <= dueS Then
       ws.Cells(PlanRow, 12).Interior.Color = RGB(198, 239, 206)
   Else
       ws.Cells(PlanRow, 12).Interior.Color = RGB(255, 199, 206)
       ws.Cells(PlanRow, 12).Font.Bold = True
   End If
 
   If doGantt Then Call AddGanttRow(ucak, op, loc, s, e)
   PlanRow = PlanRow + 1
End Sub
 
Sub AddGanttRow(ucak As String, op As String, loc As String, s As Long, e As Long)
   Dim ws As Worksheet
   Set ws = ThisWorkbook.Worksheets(WS_GANTT)
   Dim r As Long
   r = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row + 1
   If r < 4 Then r = 4
   ws.Cells(r, 1).Value = ucak
   ws.Cells(r, 2).Value = op
   ws.Cells(r, 3).Value = loc
   ws.Cells(r, 4).Value = s
   ws.Cells(r, 5).Value = e
End Sub
 
' ================================================================
' GANTT FORMAT - DÜZELTİLMİŞ 3 SATIRLI BAŞLIK
' Satir 1: Ay adlari (birlestirilen)
' Satir 2: Tarihler dd.mm (her gun 3 kolonu birlestir)
' Satir 3: V3 / V1 / V2 tekrar eden
' ================================================================
Sub FormatGantt()
   Dim wsRaw As Worksheet, ws As Worksheet
   Dim dataLast As Long, r As Long, outR As Long
   Dim s As Long, c As Long
   Dim ucak As String, op As String, loc As String, st As Long, en As Long
   Dim totalShifts As Long, startCol As Long
   Dim dayIdx As Long, colStart As Long, colEnd As Long, dateVal As Date
   Dim arr As Variant
 
   Set wsRaw = ThisWorkbook.Worksheets(WS_GANTT)
   dataLast = wsRaw.Cells(wsRaw.Rows.Count, 1).End(xlUp).Row
 
   If dataLast >= 4 Then arr = wsRaw.Range("A4:E" & dataLast).Value
 
   wsRaw.Cells.Clear
   Set ws = wsRaw
 
   startCol    = GANTT_START_COL
   totalShifts = GANTT_SHIFTS
 
   ' ── Sabit sol kolon basliklari (3 satiri birlestir) ──────
   ws.Range(ws.Cells(1, 1), ws.Cells(3, 1)).Merge
   ws.Cells(1, 1).Value = "Ucak"
   ws.Range(ws.Cells(1, 2), ws.Cells(3, 2)).Merge
   ws.Cells(1, 2).Value = "Islem"
   ws.Range(ws.Cells(1, 3), ws.Cells(3, 3)).Merge
   ws.Cells(1, 3).Value = "Konum"
 
   With ws.Range("A1:C3")
       .Interior.Color = RGB(31, 56, 100)
       .Font.Color = vbWhite
       .Font.Bold = True
       .HorizontalAlignment = xlCenter
       .VerticalAlignment = xlCenter
   End With
 
   ' ── SATIR 1: Ay adlari ───────────────────────────────────
   Dim currentMonth As String, mStart As Long, mName As String
   currentMonth = "": mStart = startCol
 
   For s = 1 To totalShifts
       mName = UCase(Format(ShiftDate(s), "mmmm yyyy"))
       c = startCol + s - 1
 
       If currentMonth = "" Then
           currentMonth = mName: mStart = c
       End If
 
       If mName <> currentMonth Or s = totalShifts Then
           Dim mEnd As Long
           mEnd = IIf(s = totalShifts And mName = currentMonth, c, c - 1)
           ws.Range(ws.Cells(1, mStart), ws.Cells(1, mEnd)).Merge
           ws.Cells(1, mStart).Value = currentMonth
           With ws.Cells(1, mStart)
               .Interior.Color = RGB(31, 56, 100)
               .Font.Color = vbWhite
               .Font.Bold = True
               .Font.Size = 11
               .HorizontalAlignment = xlCenter
               .VerticalAlignment = xlCenter
           End With
           currentMonth = mName: mStart = c
       End If
   Next s
 
   ' ── SATIR 2: Gunluk tarihler (her gun 3 kolonu birlestir)
   For dayIdx = 0 To (totalShifts - 1) \ 3
       colStart = startCol + dayIdx * 3
       colEnd   = Application.WorksheetFunction.Min(colStart + 2, startCol + totalShifts - 1)
       dateVal  = DateAdd("d", dayIdx, RefDate)
 
       ws.Range(ws.Cells(2, colStart), ws.Cells(2, colEnd)).Merge
       With ws.Cells(2, colStart)
           .Value       = Format(dateVal, "dd.mm")
           .Orientation = 90
           .HorizontalAlignment = xlCenter
           .VerticalAlignment   = xlCenter
           .Font.Bold   = True
           .Font.Size   = 8
           .Interior.Color = IIf(dayIdx Mod 2 = 0, RGB(46, 117, 182), RGB(68, 114, 196))
           .Font.Color  = vbWhite
       End With
   Next dayIdx
 
   ' ── SATIR 3: V3 / V1 / V2 tekrar ─────────────────────────
   Dim vLabels(1 To 3) As String
   vLabels(1) = "V3": vLabels(2) = "V1": vLabels(3) = "V2"
   Dim vColors(1 To 3) As Long
   vColors(1) = RGB(46, 117, 182)   ' V3 - koyu mavi
   vColors(2) = RGB(68, 114, 196)   ' V1 - orta mavi
   vColors(3) = RGB(91, 155, 213)   ' V2 - acik mavi
 
   For s = 1 To totalShifts
       c = startCol + s - 1
       Dim vIdx As Long: vIdx = ((s - 1) Mod 3) + 1
       With ws.Cells(3, c)
           .Value = vLabels(vIdx)
           .Interior.Color = vColors(vIdx)
           .Font.Color = vbWhite
           .Font.Bold  = True
           .Font.Size  = 8
           .HorizontalAlignment = xlCenter
           .VerticalAlignment   = xlCenter
       End With
   Next s
 
   ' ── Satir yukseklikleri ───────────────────────────────────
   ws.Rows(1).RowHeight = 22
   ws.Rows(2).RowHeight = 55
   ws.Rows(3).RowHeight = 16
 
   ' ── Veri satirlari ───────────────────────────────────────
   If IsEmpty(arr) Then GoTo Bitir
 
   outR = 4
   For r = 1 To UBound(arr, 1)
       ucak = CStr(arr(r, 1)): op = CStr(arr(r, 2))
       loc  = CStr(arr(r, 3)): st = CLng(arr(r, 4)): en = CLng(arr(r, 5))
 
       ws.Cells(outR, 1).Value = ucak
       ws.Cells(outR, 2).Value = op
       ws.Cells(outR, 3).Value = loc
 
       For s = st To en
           If s <= totalShifts Then
               c = startCol + s - 1
               Dim cellVal As String
               If loc = "Kabin" Then cellVal = "K"
               If loc = "Alan"  Then cellVal = "A"
               If loc = "-"     Then cellVal = "S"
               ws.Cells(outR, c).Value = cellVal
               ws.Cells(outR, c).Interior.Color = ColorForAircraft(ucak, op)
               ws.Cells(outR, c).Font.Color  = vbWhite
               ws.Cells(outR, c).Font.Bold   = True
               ws.Cells(outR, c).Font.Size   = 7
               ws.Cells(outR, c).HorizontalAlignment = xlCenter
           End If
       Next s
 
       ws.Rows(outR).RowHeight = 16
       outR = outR + 1
   Next r
 
Bitir:
   ' ── Sutun genislikleri ────────────────────────────────────
   ws.Columns(1).ColumnWidth = 10
   ws.Columns(2).ColumnWidth = 14
   ws.Columns(3).ColumnWidth = 8
 
   For c = startCol To startCol + totalShifts - 1
       ws.Columns(c).ColumnWidth = 3.2
   Next c
 
   ' ── Dondur ───────────────────────────────────────────────
   ws.Activate
   ActiveWindow.FreezePanes = False
   ws.Cells(4, startCol).Select
   ActiveWindow.FreezePanes = True
End Sub
 
