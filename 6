Function ShiftDate(absShift As Long) As Date
   ShiftDate = DateAdd("d", (absShift - 1) \ 3, RefDate)
End Function
 
Function ShiftCode(absShift As Long) As String
   Select Case ((absShift - 1) Mod 3) + 1
       Case 1: ShiftCode = "V3"
       Case 2: ShiftCode = "V1"
       Case 3: ShiftCode = "V2"
   End Select
End Function
 
Function ColorForAircraft(ucak As String, op As String) As Long
   If op = "Sealant" Then ColorForAircraft = RGB(166, 166, 166): Exit Function
   Dim n As Long, i As Long
   For i = 1 To Len(ucak)
       If Mid(ucak, i, 1) Like "#" Then n = n + CLng(Mid(ucak, i, 1))
   Next i
   Select Case n Mod 10
       Case 0: ColorForAircraft = RGB(68, 114, 196)
       Case 1: ColorForAircraft = RGB(237, 125, 49)
       Case 2: ColorForAircraft = RGB(112, 173, 71)
       Case 3: ColorForAircraft = RGB(192, 0, 0)
       Case 4: ColorForAircraft = RGB(112, 48, 160)
       Case 5: ColorForAircraft = RGB(0, 176, 240)
       Case 6: ColorForAircraft = RGB(146, 208, 80)
       Case 7: ColorForAircraft = RGB(255, 102, 255)
       Case 8: ColorForAircraft = RGB(0, 112, 192)
       Case Else: ColorForAircraft = RGB(255, 0, 0)
   End Select
End Function
 
Function WorkerIndex(workerId As String) As Long
   Dim i As Long
   For i = 1 To WorkerCount
       If NormalizeWorker(Workers(i)) = NormalizeWorker(workerId) Then WorkerIndex = i: Exit Function
   Next i
   WorkerIndex = 0
End Function
 
Function NormalizeWorker(v As Variant) As String
   If IsError(v) Or IsEmpty(v) Then NormalizeWorker = "": Exit Function
   If IsNumeric(v) Then NormalizeWorker = CStr(CLng(v)): Exit Function
   Dim s As String: s = Trim(CStr(v))
   If s Like "*.0" Then s = Replace(s, ".0", "")
   If IsNumeric(s) Then s = CStr(CLng(s))
   NormalizeWorker = s
End Function
 
Function NormalizeText(s As String) As String
   s = LCase(Trim(CStr(s)))
   s = Replace(s, Chr(305), "i")
   s = Replace(s, Chr(304), "i")
   s = Replace(s, Chr(287), "g")
   s = Replace(s, Chr(286), "g")
   s = Replace(s, Chr(252), "u")
   s = Replace(s, Chr(220), "u")
   s = Replace(s, Chr(351), "s")
   s = Replace(s, Chr(350), "s")
   s = Replace(s, Chr(246), "o")
   s = Replace(s, Chr(214), "o")
   s = Replace(s, Chr(231), "c")
   s = Replace(s, Chr(199), "c")
   s = Replace(s, " ", ""): s = Replace(s, "/", "")
   s = Replace(s, "-", ""): s = Replace(s, "_", "")
   s = Replace(s, ".", "")
   NormalizeText = s
End Function
 
Function SayfaVarMi(sayfaAdi As String) As Boolean
