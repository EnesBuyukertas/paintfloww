' ================================================================
' TAKVİM GÜNCELLE
' Parametreler!B20'deki tarihe gore Vardiya Matrisi basliklarini
' yeniden olusturur. Personel verileri (satir 7+) korunur.
' ================================================================
Sub TakvimiGuncelle()
   On Error GoTo Hata
 
   If Not SayfaVarMi(WS_PARAM) Then MsgBox "Parametreler sayfasi bulunamadi!", vbCritical: Exit Sub
   If Not SayfaVarMi(WS_VAR)   Then MsgBox "Vardiya Matrisi sayfasi bulunamadi!", vbCritical: Exit Sub
 
   Dim wsP As Worksheet: Set wsP = ThisWorkbook.Worksheets(WS_PARAM)
   Dim ws  As Worksheet: Set ws  = ThisWorkbook.Worksheets(WS_VAR)
 
   ' Baslangic tarihini oku
   If Not IsDate(wsP.Range("B20").Value) Then
       MsgBox "Parametreler!B20 gecerli bir tarih degil!" & vbCrLf & _
              "Ornek: 01.01.2027", vbExclamation
       Exit Sub
   End If
 
   Dim refD As Date: refD = CDate(wsP.Range("B20").Value)
   ' Ayin ilk gunune yuvarla
   refD = DateSerial(Year(refD), Month(refD), 1)
 
   Dim numDays As Long: numDays = 365
   Dim dayColStart As Long: dayColStart = VAR_DAY_COL
 
   Application.ScreenUpdating = False
 
   ' ── Satir 3-6 araligini temizle (baslıklar), veri satirlarini koru ──
   Dim c As Long
   ' Once satir 3-6 araligindaki gun kolonlarini temizle
   For c = dayColStart To dayColStart + numDays - 1
       ws.Cells(3, c).Value = ""
       ws.Cells(3, c).Interior.ColorIndex = xlNone
       ws.Cells(4, c).Value = ""
       ws.Cells(4, c).Interior.ColorIndex = xlNone
       ws.Cells(5, c).Value = ""
       ws.Cells(6, c).Value = ""
   Next c
 
   ' Birlesmeleri kaldir
   Dim rng As Range
   On Error Resume Next
   Set rng = ws.Range(ws.Cells(3, dayColStart), ws.Cells(4, dayColStart + numDays - 1))
   rng.UnMerge
   On Error GoTo Hata
 
   ' ── SATIR 3: Ay adlari ───────────────────────────────────
   Dim MONTH_COLORS(0 To 11) As Long
   MONTH_COLORS(0)  = RGB(31,56,100):  MONTH_COLORS(1)  = RGB(46,117,182)
   MONTH_COLORS(2)  = RGB(31,56,100):  MONTH_COLORS(3)  = RGB(46,117,182)
   MONTH_COLORS(4)  = RGB(31,56,100):  MONTH_COLORS(5)  = RGB(46,117,182)
   MONTH_COLORS(6)  = RGB(31,56,100):  MONTH_COLORS(7)  = RGB(46,117,182)
   MONTH_COLORS(8)  = RGB(31,56,100):  MONTH_COLORS(9)  = RGB(46,117,182)
   MONTH_COLORS(10) = RGB(31,56,100):  MONTH_COLORS(11) = RGB(46,117,182)
 
   Dim curMonth As Long, curYear As Long
   Dim monthStartCol As Long, monthIdx As Long
   Dim d As Long, dayDate As Date, col As Long
 
   curMonth = -1: monthStartCol = dayColStart: monthIdx = 0
 
   For d = 0 To numDays - 1
       col = dayColStart + d
       dayDate = refD + d
 
       If Month(dayDate) <> curMonth Or Year(dayDate) <> curYear Then
           ' Onceki ayi kapat
           If curMonth > 0 Then
               If col - 1 >= monthStartCol Then
                   ws.Range(ws.Cells(3, monthStartCol), ws.Cells(3, col - 1)).Merge
               End If
               With ws.Cells(3, monthStartCol)
                   .Value = UCase(Format(DateSerial(curYear, curMonth, 1), "mmmm"))
                   .Interior.Color = MONTH_COLORS(monthIdx Mod 12)
                   .Font.Name = "Calibri": .Font.Bold = True
                   .Font.Color = RGB(255, 255, 255): .Font.Size = 11
                   .HorizontalAlignment = xlCenter: .VerticalAlignment = xlCenter
               End With
               monthIdx = monthIdx + 1
           End If
           curMonth = Month(dayDate)
           curYear  = Year(dayDate)
           monthStartCol = col
       End If
   Next d
   ' Son ayi kapat
   ws.Range(ws.Cells(3, monthStartCol), ws.Cells(3, dayColStart + numDays - 1)).Merge
   With ws.Cells(3, monthStartCol)
       .Value = UCase(Format(DateSerial(curYear, curMonth, 1), "mmmm"))
       .Interior.Color = MONTH_COLORS(monthIdx Mod 12)
       .Font.Name = "Calibri": .Font.Bold = True
       .Font.Color = RGB(255, 255, 255): .Font.Size = 11
       .HorizontalAlignment = xlCenter: .VerticalAlignment = xlCenter
   End With
 
   ' ── SATIR 4: Hafta numaralari ─────────────────────────────
   Dim curWeek As Long, weekStartCol As Long, weekIdx As Long
   curWeek = -1: weekStartCol = dayColStart: weekIdx = 0
   Dim WEEK_COLORS(0 To 1) As Long
   WEEK_COLORS(0) = RGB(189,215,238): WEEK_COLORS(1) = RGB(222,234,241)
 
   For d = 0 To numDays - 1
       col = dayColStart + d
       dayDate = refD + d
       Dim wk As Long: wk = GetWeekNumber(dayDate)
 
       If wk <> curWeek Then
           If curWeek > 0 Then
               If col - 1 >= weekStartCol Then
                   ws.Range(ws.Cells(4, weekStartCol), ws.Cells(4, col - 1)).Merge
               End If
               With ws.Cells(4, weekStartCol)
                   .Value = (weekIdx + 1) & ". HAFTA"
                   .Interior.Color = WEEK_COLORS(weekIdx Mod 2)
                   .Font.Name = "Calibri": .Font.Bold = True
                   .Font.Color = RGB(31, 56, 100): .Font.Size = 8
                   .HorizontalAlignment = xlCenter: .VerticalAlignment = xlCenter
               End With
               weekIdx = weekIdx + 1
           End If
           curWeek = wk: weekStartCol = col
       End If
   Next d
   ' Son haftayi kapat
   ws.Range(ws.Cells(4, weekStartCol), ws.Cells(4, dayColStart + numDays - 1)).Merge
   With ws.Cells(4, weekStartCol)
       .Value = (weekIdx + 1) & ". HAFTA"
       .Interior.Color = WEEK_COLORS(weekIdx Mod 2)
       .Font.Name = "Calibri": .Font.Bold = True
       .Font.Color = RGB(31, 56, 100): .Font.Size = 8
       .HorizontalAlignment = xlCenter: .VerticalAlignment = xlCenter
   End With
 
   ' ── SATIR 5: Gun numaralari ───────────────────────────────
   For d = 0 To numDays - 1
       col = dayColStart + d
       dayDate = refD + d
       Dim isWeekend As Boolean: isWeekend = (Weekday(dayDate, vbMonday) >= 6)
       With ws.Cells(5, col)
           .Value = Day(dayDate)
           .Interior.Color = IIf(isWeekend, RGB(252, 228, 214), RGB(237, 237, 237))
           .Font.Name = "Calibri": .Font.Bold = True: .Font.Size = 8
           .Font.Color = RGB(31, 56, 100)
           .HorizontalAlignment = xlCenter: .VerticalAlignment = xlCenter
       End With
   Next d
 
   ' ── SATIR 6: Gun adlari (dikey) ───────────────────────────
   Dim gunAdlari(0 To 6) As String
   gunAdlari(0) = "PAZARTESİ": gunAdlari(1) = "SALI":      gunAdlari(2) = "ÇARŞAMBA"
   gunAdlari(3) = "PERŞEMBE":  gunAdlari(4) = "CUMA":      gunAdlari(5) = "CUMARTESİ"
   gunAdlari(6) = "PAZAR"
 
   For d = 0 To numDays - 1
       col = dayColStart + d
       dayDate = refD + d
       Dim wdIdx As Long: wdIdx = Weekday(dayDate, vbMonday) - 1
       isWeekend = (wdIdx >= 5)
       With ws.Cells(6, col)
           .Value = gunAdlari(wdIdx)
           .Interior.Color = IIf(isWeekend, RGB(252, 228, 214), RGB(255, 255, 255))
           .Font.Name = "Calibri": .Font.Bold = True: .Font.Size = 7
           .Font.Color = RGB(31, 56, 100)
           .Orientation = 90
           .HorizontalAlignment = xlCenter: .VerticalAlignment = xlBottom
       End With
   Next d
 
   Application.ScreenUpdating = True
   MsgBox "Takvim " & Year(refD) & " yilina guncellendi!" & vbCrLf & _
          "Personel verileri korundu. Vardiya atamalarini kontrol ediniz.", _
          vbInformation, "Takvim Guncellendi"
   Exit Sub
 
Hata:
   Application.ScreenUpdating = True
   MsgBox "HATA: " & Err.Description, vbCritical
End Sub
 
' ── Yardimci: Hex rengi R/G/B parcalara ayir ──────────────────
Function HexToR(hex As String) As Long
   HexToR = CLng("&H" & Left(hex, 2))
End Function
Function HexToG(hex As String) As Long
   HexToG = CLng("&H" & Mid(hex, 3, 2))
End Function
Function HexToB(hex As String) As Long
   HexToB = CLng("&H" & Right(hex, 2))
End Function
 
' ── Yardimci: Hafta numarasi hesapla ──────────────────────────
Function GetWeekNumber(d As Date) As Long
   GetWeekNumber = DatePart("ww", d, vbMonday, vbFirstFourDays)
End Function
 
Sub PlaniTemizle()
   If MsgBox("Plan ve Gantt temizlenecek. Emin misiniz?", vbYesNo + vbQuestion) = vbYes Then
       With ThisWorkbook.Worksheets(WS_PLAN)
           .Rows(PLAN_FIRST_ROW & ":" & .Rows.Count).ClearContents
           .Rows(PLAN_FIRST_ROW & ":" & .Rows.Count).Interior.ColorIndex = xlNone
       End With
       With ThisWorkbook.Worksheets(WS_GANTT)
           .Rows("4:" & .Rows.Count).ClearContents
           .Rows("4:" & .Rows.Count).Interior.ColorIndex = xlNone
       End With
       MsgBox "Plan temizlendi.", vbInformation
   End If
End Sub
 
Sub GecikmeKontrol()
   Dim ws As Worksheet: Set ws = ThisWorkbook.Worksheets(WS_PLAN)
   Dim r As Long, cnt As Long: cnt = 0
   r = PLAN_FIRST_ROW
   Do While ws.Cells(r, 1).Value <> ""
       If InStr(ws.Cells(r, 12).Value, "GECIKME") > 0 Then cnt = cnt + 1
       r = r + 1
   Loop
   If cnt = 0 Then
       MsgBox "Gecikme riski bulunmamaktadir.", vbInformation
   Else
       MsgBox cnt & " satirda gecikme riski var! Kirmizi satirlari inceleyiniz.", vbExclamation
   End If
End Sub
 
