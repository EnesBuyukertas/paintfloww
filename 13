Private Sub ApplyCandidate(ac As Long, cType As String, op As Long, s As Long, e As Long, loc As String)
   Select Case cType
       Case "SEALANT"
           Dim t As Long
           For t = s To e: SealantActive(ac, t) = True: Next t
           Call WritePlanRow(AircraftNo(ac), "Sealant", "-", s, e, "-", PriorityVal(ac), DueShift(ac), "Sealant Blogu")
           ReadyShift(ac) = e + 1
 
       Case "NORMAL"
           Call ReserveLocation(ac, loc, s, e)
           Call ReserveWorkers(op, s, e, OpNeed(op))
           Dim workerTxt As String: workerTxt = GetWorkerText(op, s, e, OpNeed(op))
           Call WritePlanRow(AircraftNo(ac), OpName(op), loc, s, e, workerTxt, PriorityVal(ac), DueShift(ac), "Normal")
           LastLoc(ac) = loc
           ReadyShift(ac) = e + 1
 
       Case "EQP"
           Call ApplyEQP(ac, s, loc)
           ReadyShift(ac) = e + 1
   End Select
 
   StageIdx(ac) = StageIdx(ac) + 1
   If StageIdx(ac) > 7 Then DoneAircraft(ac) = True
End Sub
 
Private Sub ApplyEQP(ac As Long, s As Long, locPattern As String)
   Dim parts() As String: parts = Split(locPattern, "-")
   Dim loc1 As String: loc1 = parts(0)
   Dim loc2 As String: loc2 = parts(1)
   Dim worker As Long: worker = FindEQPWorker(s)
   If worker = 0 Then Exit Sub
 
   ' Lokasyon ve isci rezervasyonu
   Call ReserveOneShift(ac, loc1, s)
   Call ReserveOneShift(ac, loc2, s + 1)
   Busy(worker, s) = True: Busy(worker, s + 1) = True
 
   Dim wtxt As String
   wtxt = "V" & s & ": " & Workers(worker) & " | V" & (s+1) & ": " & Workers(worker)
   Call WritePlanRow(AircraftNo(ac), "EQP", loc1 & "->" & loc2, s, s + 1, wtxt, PriorityVal(ac), DueShift(ac), "EQP (2 vardiya)")
   LastLoc(ac) = loc2
End Sub
 
Private Sub ReserveLocation(ac As Long, loc As String, s As Long, e As Long)
   Dim t As Long
   For t = s To e
       If loc = "Alan"  Then AlanDolu(t)  = AlanDolu(t)  + 1
       If loc = "Kabin" Then KabinDolu(t) = KabinDolu(t) + 1
       AircraftLoc(ac, t) = loc
   Next t
End Sub
 
Private Sub ReserveOneShift(ac As Long, loc As String, s As Long)
   If AircraftLoc(ac, s) = "" Then
       If loc = "Alan"  Then AlanDolu(s)  = AlanDolu(s)  + 1
       If loc = "Kabin" Then KabinDolu(s) = KabinDolu(s) + 1
       AircraftLoc(ac, s) = loc
   End If
End Sub
 
Private Sub ReserveWorkers(op As Long, s As Long, e As Long, need As Long)
   Dim t As Long, w As Long, cnt As Long
   For t = s To e
       cnt = 0
       For w = 1 To WorkerCount
           If Skill(w, op) And Avail(w, t) And Not Busy(w, t) Then
               Busy(w, t) = True: cnt = cnt + 1
               If cnt >= need Then Exit For
           End If
       Next w
   Next t
End Sub
 
Function GetWorkerText(op As Long, s As Long, e As Long, need As Long) As String
   Dim t As Long, w As Long, cnt As Long, txt As String
   For t = s To e
       cnt = 0: txt = txt & "V" & t & ": "
       For w = 1 To WorkerCount
           If Skill(w, op) And Avail(w, t) And Busy(w, t) Then
               If cnt > 0 Then txt = txt & ", "
               txt = txt & Workers(w): cnt = cnt + 1
               If cnt >= need Then Exit For
           End If
       Next w
       If t < e Then txt = txt & " | "
   Next t
   GetWorkerText = txt
End Function
 
