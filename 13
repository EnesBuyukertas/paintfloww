Function ShiftToDate(absShift As Long) As Date
   ShiftToDate = DateAdd("d", (absShift - 1) \ 3, RefDate)
End Function
 
Function ShiftToCode(absShift As Long) As String
   Select Case ((absShift - 1) Mod 3) + 1
       Case 1: ShiftToCode = "V3"
       Case 2: ShiftToCode = "V1"
       Case 3: ShiftToCode = "V2"
   End Select
End Function
 
Function AircraftColor(ucak As String, op As String) As Long
   If op = "Sealant" Then AircraftColor = RGB(166, 166, 166): Exit Function
   Dim n As Long, i As Long
   For i = 1 To Len(ucak)
       If Mid(ucak, i, 1) Like "#" Then n = n + CLng(Mid(ucak, i, 1))
   Next i
   Select Case n Mod 10
       Case 0: AircraftColor = RGB(68, 114, 196)
       Case 1: AircraftColor = RGB(237, 125, 49)
       Case 2: AircraftColor = RGB(112, 173, 71)
       Case 3: AircraftColor = RGB(192, 0, 0)
       Case 4: AircraftColor = RGB(112, 48, 160)
       Case 5: AircraftColor = RGB(0, 176, 240)
       Case 6: AircraftColor = RGB(146, 208, 80)
       Case 7: AircraftColor = RGB(255, 102, 255)
       Case 8: AircraftColor = RGB(0, 112, 192)
       Case Else: AircraftColor = RGB(255, 0, 0)
   End Select
End Function
 
Function NormalizeText(s As String) As String
   s = LCase(Trim(CStr(s)))
   s = Replace(s, Chr(305), "i"): s = Replace(s, Chr(304), "i")
   s = Replace(s, Chr(287), "g"): s = Replace(s, Chr(286), "g")
   s = Replace(s, Chr(252), "u"): s = Replace(s, Chr(220), "u")
   s = Replace(s, Chr(351), "s"): s = Replace(s, Chr(350), "s")
   s = Replace(s, Chr(246), "o"): s = Replace(s, Chr(214), "o")
   s = Replace(s, Chr(231), "c"): s = Replace(s, Chr(199), "c")
   s = Replace(s, " ", ""): s = Replace(s, "/", "")
   s = Replace(s, "-", ""): s = Replace(s, "_", "")
   s = Replace(s, ".", "")
   NormalizeText = s
End Function
 
