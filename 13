Option Explicit
 
' ================================================================
' BOYAHANE URETIM PLANLAMA MAKROSU v5
' - Temiz v3 kod yapisi korundu
' - Kabiliyet ve Vardiya matrisi ayni Excel'den okunuyor
' - Dinamik zamanlama (tum ucaklar karsilastirilarak en iyi is secilir)
' - EQP: ayni kisi 2 vardiya zorunlulugu
' - Dis Boya: Sealant aktifken ayni ucakta yapilamaz
' - Gantt: 3 satirli baslik (Ay / Tarih / V3-V1-V2)
' - Sealant: lokasyon degil, 2 vardijalik blok kisit
' ================================================================
 
Const WS_PARAM   As String = "Parametreler"
Const WS_GIRIS   As String = "Giris"
Const WS_KAB     As String = "Kabiliyet Matrisi"
Const WS_VAR     As String = "Vardiya Matrisi"
Const WS_PLAN    As String = "Vardiya Plani"
Const WS_GANTT   As String = "Gantt Chart"
 
Const GIRIS_FIRST_ROW As Long = 4
Const PLAN_FIRST_ROW  As Long = 4
Const GANTT_START_COL As Long = 4
Const KAB_FIRST_ROW   As Long = 4   ' Kabiliyet matrisi veri baslangic satiri
Const VAR_FIRST_ROW   As Long = 7   ' Vardiya matrisi veri baslangic satiri
Const VAR_DAY_COL     As Long = 6   ' Vardiya matrisinde ilk gun kolonu
Const VAR_NAME_COL    As Long = 5   ' Vardiya matrisinde Ad Soyad kolonu (E=5)
                                        ' A=Grup, B=Bina, C=Vardiya formulu, D=Sicil no, E=Ad Soyad
 
Const DEFAULT_ALAN_KAP  As Long = 6
Const DEFAULT_KABIN_KAP As Long = 2
Const MAX_SHIFT         As Long = 1200
Const GANTT_SHIFTS      As Long = 1095
Const MAX_AIRCRAFT      As Long = 200
Const MAX_WORKERS       As Long = 300
Const MAX_OPS           As Long = 6
 
Const OP_PRIMER  As Long = 1
Const OP_VERNIK  As Long = 2
Const OP_VTU     As Long = 3
Const OP_DISBOYA As Long = 4
Const OP_EQP     As Long = 5
Const OP_FINAL   As Long = 6
 
' Islem tanimlari
Dim OpName(1 To MAX_OPS)  As String
Dim OpDur(1 To MAX_OPS)   As Long
Dim OpNeed(1 To MAX_OPS)  As Long
 
' Kapasite
Dim AlanKap  As Long
Dim KabinKap As Long
Dim NormalVarPerDay As Long
Dim AcilVarPerDay   As Long
 
' Tarihler
Dim RefDate        As Date   ' En erken ucak gelis tarihi
Dim VardiyaRefDate As Date   ' Vardiya matrisinin baslangic tarihi
 
' Islem sirasi
Dim StageOrder(1 To 7) As String
Dim PrimerOnce     As Boolean
 
' Isci verileri
Dim WorkerCount As Long
Dim Workers(1 To MAX_WORKERS)                   As String
Dim Skill(1 To MAX_WORKERS, 1 To MAX_OPS)       As Boolean
Dim Avail(1 To MAX_WORKERS, 1 To MAX_SHIFT)     As Boolean
Dim Busy(1 To MAX_WORKERS, 1 To MAX_SHIFT)      As Boolean
 
' Ucak verileri
Dim AircraftCount                               As Long
Dim AircraftNo(1 To MAX_AIRCRAFT)               As String
Dim ArrivalDate(1 To MAX_AIRCRAFT)              As Date
Dim DueDate(1 To MAX_AIRCRAFT)                  As Date
Dim PriorityVal(1 To MAX_AIRCRAFT)              As Long
Dim ArrivalShift(1 To MAX_AIRCRAFT)             As Long
Dim DueShift(1 To MAX_AIRCRAFT)                 As Long
Dim StageIdx(1 To MAX_AIRCRAFT)                 As Long
Dim ReadyShift(1 To MAX_AIRCRAFT)               As Long
Dim DoneAircraft(1 To MAX_AIRCRAFT)             As Boolean
Dim LastLoc(1 To MAX_AIRCRAFT)                  As String
 
' Doluluk ve konum takibi
Dim AlanDolu(1 To MAX_SHIFT)                    As Long
Dim KabinDolu(1 To MAX_SHIFT)                   As Long
Dim AircraftLoc(1 To MAX_AIRCRAFT, 1 To MAX_SHIFT)   As String
Dim SealantActive(1 To MAX_AIRCRAFT, 1 To MAX_SHIFT) As Boolean
 
Dim PlanRow As Long
 
' ================================================================
' ANA FONKSİYON
' ================================================================
Sub PlanOlustur()
   On Error GoTo HataYonetimi
   Application.ScreenUpdating = False
   Application.Calculation = xlCalculationManual
 
   If Not SayfaVarMi(WS_PARAM)  Then MsgBox "'" & WS_PARAM  & "' sayfasi bulunamadi!", vbCritical: GoTo Temizle
   If Not SayfaVarMi(WS_GIRIS)  Then MsgBox "'" & WS_GIRIS  & "' sayfasi bulunamadi!", vbCritical: GoTo Temizle
   If Not SayfaVarMi(WS_KAB)    Then MsgBox "'" & WS_KAB    & "' sayfasi bulunamadi!", vbCritical: GoTo Temizle
   If Not SayfaVarMi(WS_VAR)    Then MsgBox "'" & WS_VAR    & "' sayfasi bulunamadi!", vbCritical: GoTo Temizle
   If Not SayfaVarMi(WS_PLAN)   Then MsgBox "'" & WS_PLAN   & "' sayfasi bulunamadi!", vbCritical: GoTo Temizle
   If Not SayfaVarMi(WS_GANTT)  Then MsgBox "'" & WS_GANTT  & "' sayfasi bulunamadi!", vbCritical: GoTo Temizle
 
   Call InitModel
   Call ReadAircraftList
   Call ReadKabiliyetMatrix
   Call ReadVardiyaMatrix
   Call ValidateWorkers
   Call PrepareOutputSheets
   Call DynamicSchedule
   Call FormatGantt
 
   Application.Calculation = xlCalculationAutomatic
   Application.ScreenUpdating = True
   MsgBox AircraftCount & " ucak icin plan basariyla olusturuldu!" & vbCrLf & _
          "Vardiya Plani ve Gantt Chart sayfalarini kontrol ediniz.", vbInformation, "Plan Olusturuldu"
   Exit Sub
 
HataYonetimi:
   Application.Calculation = xlCalculationAutomatic
   Application.ScreenUpdating = True
   MsgBox "HATA: " & Err.Description & vbCrLf & "Hata No: " & Err.Number, vbCritical, "Makro Hatasi"
   Exit Sub
 
Temizle:
   Application.Calculation = xlCalculationAutomatic
   Application.ScreenUpdating = True
End Sub
 
' ================================================================
' MODEL BASLAT
' ================================================================
Private Sub InitModel()
   Dim wsP As Worksheet
   Set wsP = ThisWorkbook.Worksheets(WS_PARAM)
 
   AlanKap  = DEFAULT_ALAN_KAP
   KabinKap = DEFAULT_KABIN_KAP
   If IsNumeric(wsP.Range("B5").Value) Then AlanKap  = CLng(wsP.Range("B5").Value)
   If IsNumeric(wsP.Range("B6").Value) Then KabinKap = CLng(wsP.Range("B6").Value)
   If IsNumeric(wsP.Range("B7").Value) Then NormalVarPerDay = CLng(wsP.Range("B7").Value)
   If IsNumeric(wsP.Range("B8").Value) Then AcilVarPerDay   = CLng(wsP.Range("B8").Value)
   If AlanKap  < 1 Then AlanKap  = DEFAULT_ALAN_KAP
   If KabinKap < 1 Then KabinKap = DEFAULT_KABIN_KAP
   If NormalVarPerDay < 1 Then NormalVarPerDay = 2
   If AcilVarPerDay   < 1 Then AcilVarPerDay   = 3
 
   ' Vardiya referans tarihi
   If IsDate(wsP.Range("B20").Value) Then
       VardiyaRefDate = CDate(wsP.Range("B20").Value)
   Else
       VardiyaRefDate = DateSerial(2026, 1, 1)
   End If
 
   ' Primer/Sealant sirasi
   PrimerOnce = (UCase(Trim(CStr(wsP.Range("B21").Value))) = "PRIMER")
 
   ' Islem tanimlari: sure ve gereken kisi sayisi
   OpName(OP_PRIMER)  = "Primer":         OpDur(OP_PRIMER)  = 1: OpNeed(OP_PRIMER)  = 4
   OpName(OP_VERNIK)  = "Vernik":         OpDur(OP_VERNIK)  = 1: OpNeed(OP_VERNIK)  = 2
   OpName(OP_VTU)     = "Vernik Touchup": OpDur(OP_VTU)     = 1: OpNeed(OP_VTU)     = 4
   OpName(OP_DISBOYA) = "Dis Boya":       OpDur(OP_DISBOYA) = 1: OpNeed(OP_DISBOYA) = 1
   OpName(OP_EQP)     = "EQP":            OpDur(OP_EQP)     = 2: OpNeed(OP_EQP)     = 1
   OpName(OP_FINAL)   = "Final":          OpDur(OP_FINAL)   = 2: OpNeed(OP_FINAL)   = 1
 
   ' Islem sirasi
   If PrimerOnce Then
       StageOrder(1) = "Primer":        StageOrder(2) = "Sealant"
   Else
       StageOrder(1) = "Sealant":       StageOrder(2) = "Primer"
   End If
   StageOrder(3) = "Vernik"
   StageOrder(4) = "Vernik Touchup"
   StageOrder(5) = "Dis Boya"
   StageOrder(6) = "EQP"
   StageOrder(7) = "Final"
End Sub
 
' ================================================================
' UCAK LİSTESİ
' ================================================================
Private Sub ReadAircraftList()
   Dim ws As Worksheet, r As Long, i As Long
   Set ws = ThisWorkbook.Worksheets(WS_GIRIS)
 
   AircraftCount = 0
   r = GIRIS_FIRST_ROW
   Do While Trim(CStr(ws.Cells(r, 2).Value)) <> ""
       AircraftCount = AircraftCount + 1
       AircraftNo(AircraftCount)  = Trim(CStr(ws.Cells(r, 2).Value))
       On Error Resume Next
       ArrivalDate(AircraftCount) = CDate(ws.Cells(r, 3).Value)
       DueDate(AircraftCount)     = CDate(ws.Cells(r, 4).Value)
       On Error GoTo 0
       PriorityVal(AircraftCount) = IIf(IsNumeric(ws.Cells(r, 5).Value), CLng(ws.Cells(r, 5).Value), 3)
       r = r + 1
       If AircraftCount >= MAX_AIRCRAFT Then Exit Do
   Loop
 
   If AircraftCount = 0 Then
       MsgBox "Giris sayfasinda ucak bulunamadi!", vbExclamation
       End
   End If
 
   ' En erken gelis tarihini bul
   RefDate = ArrivalDate(1)
   For i = 2 To AircraftCount
       If ArrivalDate(i) < RefDate Then RefDate = ArrivalDate(i)
   Next i
 
   ' Vardiya numaralarini hesapla (3 vardiya/gun)
   For i = 1 To AircraftCount
       ArrivalShift(i) = DateDiff("d", RefDate, ArrivalDate(i)) * 3 + 1
       DueShift(i)     = DateDiff("d", RefDate, DueDate(i)) * 3 + 3
       StageIdx(i)     = 1
       ReadyShift(i)   = ArrivalShift(i)
       DoneAircraft(i) = False
       LastLoc(i)      = ""
   Next i
 
   ' Oncelik siralaması
   Call SortAircraft
End Sub
 
Private Sub SortAircraft()
   Dim i As Long, j As Long
   Dim ts As String, td As Date, tl As Long
   For i = 1 To AircraftCount - 1
       For j = i + 1 To AircraftCount
           Dim swap As Boolean: swap = False
           If PriorityVal(i) > PriorityVal(j) Then swap = True
           If PriorityVal(i) = PriorityVal(j) And ArrivalDate(i) > ArrivalDate(j) Then swap = True
           If PriorityVal(i) = PriorityVal(j) And ArrivalDate(i) = ArrivalDate(j) And DueDate(i) > DueDate(j) Then swap = True
           If swap Then
               ts = AircraftNo(i):  AircraftNo(i)  = AircraftNo(j):  AircraftNo(j)  = ts
               td = ArrivalDate(i): ArrivalDate(i) = ArrivalDate(j): ArrivalDate(j) = td
               td = DueDate(i):     DueDate(i)     = DueDate(j):     DueDate(j)     = td
               tl = PriorityVal(i): PriorityVal(i) = PriorityVal(j): PriorityVal(j) = tl
               tl = ArrivalShift(i):ArrivalShift(i)= ArrivalShift(j):ArrivalShift(j)= tl
               tl = DueShift(i):    DueShift(i)    = DueShift(j):    DueShift(j)    = tl
           End If
       Next j
   Next i
End Sub
 
' ================================================================
' KABİLİYET MATRİSİ OKU (Ayni Excel'deki sayfa)
' ================================================================
Private Sub ReadKabiliyetMatrix()
   Dim ws As Worksheet, r As Long, c As Long
   Dim lastRow As Long, lastCol As Long
   Dim name As String, hdr As String, op As Long, val As String
 
   Set ws = ThisWorkbook.Worksheets(WS_KAB)
 
   ' Son satiri B kolonundan bul
   lastRow = ws.Cells(ws.Rows.Count, 2).End(xlUp).Row
 
   ' Son kolonu baslik satirindan bul (3. satir)
   ' Bircok yontemle dene, en guvenilir olanı kullan
   lastCol = 2
   For c = 3 To 20
       If Trim(CStr(ws.Cells(3, c).Value)) <> "" Then
           lastCol = c
       End If
   Next c
 
   WorkerCount = 0
 
   ' Isci isimlerini oku (B kolonu, 4. satirdan itibaren)
   Dim w As Long
   For r = KAB_FIRST_ROW To lastRow
       name = Trim(CStr(ws.Cells(r, 2).Value))
       If name <> "" Then
           WorkerCount = WorkerCount + 1
           If WorkerCount > MAX_WORKERS Then Exit For
           Workers(WorkerCount) = name
           For w = 1 To MAX_OPS: Skill(WorkerCount, w) = False: Next w
       End If
   Next r
 
   ' Yetenek kolonlarini oku (C kolonundan = kolon 3)
   For c = 3 To lastCol
       hdr = Trim(CStr(ws.Cells(3, c).Value))
       op = HeaderToOp(hdr)
       If op > 0 Then
           Dim wi As Long: wi = 0
           For r = KAB_FIRST_ROW To lastRow
               name = Trim(CStr(ws.Cells(r, 2).Value))
               If name <> "" Then
                   wi = wi + 1
                   If wi <= WorkerCount Then
                       val = UCase(Trim(CStr(ws.Cells(r, c).Value)))
                       ' X veya kirmizi X (renk farketmez, deger X ise yetenekli)
                       Skill(wi, op) = (val = "X")
                   End If
               End If
           Next r
       End If
   Next c
 
   If WorkerCount = 0 Then
       MsgBox "Kabiliyet Matrisi sayfasinda isci bulunamadi!" & vbCrLf & _
              "Lutfen Ad Soyad kolonunu (B) doldurunuz.", vbExclamation
       End
   End If
End Sub
 
Function HeaderToOp(hdr As String) As Long
   Dim h As String: h = NormalizeText(hdr)
   If h = NormalizeText("EQP")           Then HeaderToOp = OP_EQP:     Exit Function
   If h = NormalizeText("Primer")        Then HeaderToOp = OP_PRIMER:  Exit Function
   If h = NormalizeText("Vernik")        Then HeaderToOp = OP_VERNIK:  Exit Function
   If h = NormalizeText("Vernik Touchup") Or h = NormalizeText("vernikto uchup") Or h = NormalizeText("vernikouchup") Then HeaderToOp = OP_VTU: Exit Function
   If h = NormalizeText("Dis Boya") Or h = NormalizeText("disboya") Then HeaderToOp = OP_DISBOYA: Exit Function
   If h = NormalizeText("Final")         Then HeaderToOp = OP_FINAL:   Exit Function
   HeaderToOp = 0
End Function
 
' ================================================================
' VARDİYA MATRİSİ OKU (Ayni Excel'deki sayfa)
' ================================================================
Private Sub ReadVardiyaMatrix()
   Dim ws As Worksheet, r As Long, c As Long
   Dim lastRow As Long, lastCol As Long
   Dim name As String, code As String
   Dim wIdx As Long, shiftIdx As Long, absShift As Long
   Dim dayDate As Date, planDay As Long
 
   Set ws = ThisWorkbook.Worksheets(WS_VAR)
 
   lastRow = ws.Cells(ws.Rows.Count, VAR_NAME_COL).End(xlUp).Row
   lastCol = ws.Cells(5, ws.Columns.Count).End(xlToLeft).Column
 
   ' Tum iscileri baslangicta musait degil yap
   Dim w As Long, s As Long
   For w = 1 To WorkerCount
       For s = 1 To MAX_SHIFT
           Avail(w, s) = False
           Busy(w, s)  = False
       Next s
   Next w
 
   ' Veri satirlarini oku
   For r = VAR_FIRST_ROW To lastRow
       name = Trim(CStr(ws.Cells(r, VAR_NAME_COL).Value))
       wIdx = WorkerIndexByName(name)
 
       If wIdx > 0 Then
           For c = VAR_DAY_COL To lastCol
               code = UCase(Trim(CStr(ws.Cells(r, c).Value)))
 
               If code = "V1" Or code = "V2" Or code = "V3" Then
                   ' Gün tarihini hesapla (satir 2'de tarih var)
                   ' Tarih hesabi:
                   ' Satir 5 = gun numarasi (1-31)
                   ' Satir 3 = ay adi (OCAK, SUBAT...) - hangi ayda oldugunu bul
                   Dim gunNo As Long
                   gunNo = 0
                   If IsNumeric(ws.Cells(5, c).Value) Then gunNo = CLng(ws.Cells(5, c).Value)
 
                   If gunNo >= 1 And gunNo <= 31 Then
                       ' Ay adini bul: o kolonda veya soluna dogru merge edilmis hucreyi tara
                       Dim ayAdi As String: ayAdi = ""
                       Dim cc As Long
                       For cc = c To DAY_COL_START Step -1
                           Dim v3 As String: v3 = Trim(CStr(ws.Cells(3, cc).Value))
                           If v3 <> "" Then ayAdi = v3: Exit For
                       Next cc
 
                       Dim ayNo As Long: ayNo = AyAdindanNo(ayAdi)
                       If ayNo > 0 Then
                           On Error Resume Next
                           dayDate = DateSerial(VardiyaRefDate.Year, ayNo, gunNo)
                           ' Eger gun gecmisteyse bir sonraki yil dene
                           If dayDate < VardiyaRefDate Then
                               dayDate = DateSerial(VardiyaRefDate.Year + 1, ayNo, gunNo)
                           End If
                           On Error GoTo 0
                           planDay = DateDiff("d", RefDate, dayDate)
                           If planDay >= 0 Then
                               shiftIdx = ShiftCodeToIndex(code)
                               absShift = planDay * 3 + shiftIdx
                               If absShift >= 1 And absShift <= MAX_SHIFT Then
                                   Avail(wIdx, absShift) = True
                               End If
                           End If
                       End If
                   End If
               End If
           Next c
       End If
   Next r
End Sub
 
Function ShiftCodeToIndex(code As String) As Long
   Select Case UCase(Trim(code))
       Case "V3": ShiftCodeToIndex = 1
       Case "V1": ShiftCodeToIndex = 2
       Case "V2": ShiftCodeToIndex = 3
       Case Else: ShiftCodeToIndex = 0
   End Select
End Function
 
Function WorkerIndexByName(name As String) As Long
   Dim i As Long, n1 As String, n2 As String
   n1 = NormalizeText(name)
   For i = 1 To WorkerCount
       n2 = NormalizeText(Workers(i))
       If n1 = n2 Then WorkerIndexByName = i: Exit Function
   Next i
   WorkerIndexByName = 0
End Function
 
' ================================================================
' ISCI VALIDASYON
' ================================================================
Private Sub ValidateWorkers()
   Dim w As Long, op As Long, totalAvail As Long
   Dim warnings As String: warnings = ""
 
   For op = 1 To MAX_OPS
       Dim cnt As Long: cnt = 0
       For w = 1 To WorkerCount
           If Skill(w, op) Then cnt = cnt + 1
       Next w
       If cnt = 0 Then
           warnings = warnings & "- " & OpName(op) & " icin yetenekli isci yok!" & vbCrLf
       ElseIf cnt < OpNeed(op) Then
           warnings = warnings & "- " & OpName(op) & ": " & cnt & " yetenekli isci var, " & OpNeed(op) & " gerekiyor!" & vbCrLf
       End If
   Next op
 
   ' Toplam musait vardiya kontrolu
   totalAvail = 0
   For w = 1 To WorkerCount
       Dim s As Long
       For s = 1 To MAX_SHIFT
           If Avail(w, s) Then totalAvail = totalAvail + 1
       Next s
   Next w
 
   If totalAvail = 0 Then
       MsgBox "Vardiya Matrisi sayfasinda hicbir vardiya ataması bulunamadi!" & vbCrLf & _
              "Ad Soyad kolonunun Kabiliyet Matrisi ile ayni oldugunu kontrol edin.", vbExclamation
       End
   End If
 
   If warnings <> "" Then
       If MsgBox("Uyarilar:" & vbCrLf & warnings & vbCrLf & "Devam edilsin mi?", vbYesNo + vbExclamation) = vbNo Then End
   End If
End Sub
 
' ================================================================
' DİNAMİK ZAMANLAMA
' ================================================================
Private Sub DynamicSchedule()
   Dim iter As Long, ac As Long, bestAc As Long
   Dim bestScore As Double, sc As Double
   Dim cStart As Long, cEnd As Long, cLoc As String, cType As String, cOp As Long
   Dim bStart As Long, bEnd As Long, bLoc As String, bType As String, bOp As Long
   Dim found As Boolean
 
   For iter = 1 To 50000
       found = False
       bestScore = 1E+30
       bestAc = 0
 
       ' Tum ucaklarin bir sonraki adayini bul, en iyisini sec
       For ac = 1 To AircraftCount
           If Not DoneAircraft(ac) Then
               If GetCandidate(ac, cType, cOp, cStart, cEnd, cLoc) Then
                   ' Skor: once erken baslangic, sonra oncelik, sonra gelis, sonra teslim
                   sc = cStart * 100000# + PriorityVal(ac) * 1000# + ArrivalShift(ac) * 10# + DueShift(ac)
                   If sc < bestScore Then
                       bestScore = sc: bestAc = ac
                       bType = cType: bOp = cOp
                       bStart = cStart: bEnd = cEnd: bLoc = cLoc
                       found = True
                   End If
               End If
           End If
       Next ac
 
       If Not found Then Exit For
       Call ApplyCandidate(bestAc, bType, bOp, bStart, bEnd, bLoc)
   Next iter
End Sub
 
Function GetCandidate(ac As Long, ByRef cType As String, ByRef cOp As Long, ByRef cStart As Long, ByRef cEnd As Long, ByRef cLoc As String) As Boolean
   If StageIdx(ac) > 7 Then DoneAircraft(ac) = True: GetCandidate = False: Exit Function
 
   Dim st As String: st = StageOrder(StageIdx(ac))
   Dim locPref(1 To 2) As String
 
   Select Case st
       Case "Sealant"
           cType = "SEALANT": cOp = 0
           cStart = ReadyShift(ac): cEnd = cStart + 1: cLoc = "-"
           GetCandidate = True
 
       Case "Primer"
           Call BuildLocPref(ac, locPref)
           cType = "NORMAL": cOp = OP_PRIMER
           GetCandidate = FindNormalSlot(ac, OP_PRIMER, ReadyShift(ac), locPref, cStart, cEnd, cLoc)
 
       Case "Vernik"
           locPref(1) = "Kabin": locPref(2) = ""
           cType = "NORMAL": cOp = OP_VERNIK
           GetCandidate = FindNormalSlot(ac, OP_VERNIK, ReadyShift(ac), locPref, cStart, cEnd, cLoc)
 
       Case "Vernik Touchup"
           Call BuildLocPref(ac, locPref)
           cType = "NORMAL": cOp = OP_VTU
           GetCandidate = FindNormalSlot(ac, OP_VTU, ReadyShift(ac), locPref, cStart, cEnd, cLoc)
 
       Case "Dis Boya"
           locPref(1) = "Kabin": locPref(2) = ""
           cType = "NORMAL": cOp = OP_DISBOYA
           GetCandidate = FindNormalSlot(ac, OP_DISBOYA, ArrivalShift(ac), locPref, cStart, cEnd, cLoc)
 
       Case "EQP"
           cType = "EQP": cOp = OP_EQP
           GetCandidate = FindEQPSlot(ac, cStart, cEnd, cLoc)
 
       Case "Final"
           Call BuildLocPref(ac, locPref)
           cType = "NORMAL": cOp = OP_FINAL
           GetCandidate = FindNormalSlot(ac, OP_FINAL, ReadyShift(ac), locPref, cStart, cEnd, cLoc)
   End Select
End Function
 
Private Sub BuildLocPref(ac As Long, ByRef locPref() As String)
   If LastLoc(ac) = "Kabin" Then
       locPref(1) = "Kabin": locPref(2) = "Alan"
   Else
       locPref(1) = "Alan": locPref(2) = "Kabin"
   End If
End Sub
 
Function FindNormalSlot(ac As Long, op As Long, earliest As Long, locPref() As String, ByRef sOut As Long, ByRef eOut As Long, ByRef locOut As String) As Boolean
   Dim k As Long, s As Long, loc As String, dur As Long
   dur = OpDur(op)
 
   For k = 1 To 2
       loc = locPref(k)
       If loc = "" Then GoTo NextLoc
 
       For s = earliest To MAX_SHIFT - dur + 1
           ' Dis Boya Sealant cakisma kontrolu
           If op = OP_DISBOYA And SealantConflict(ac, s, dur) Then GoTo NextShift
           ' Lokasyon kapasitesi
           If Not LocationOK(loc, s, dur) Then GoTo NextShift
           ' Ucak baska is yapiyor mu
           If Not AircraftFree(ac, s, dur) Then GoTo NextShift
           ' Yeterli musait isci var mi
           If Not WorkersOK(op, s, dur, OpNeed(op)) Then GoTo NextShift
 
           sOut = s: eOut = s + dur - 1: locOut = loc
           FindNormalSlot = True: Exit Function
NextShift:
       Next s
NextLoc:
   Next k
 
   FindNormalSlot = False
End Function
 
Function LocationOK(loc As String, s As Long, dur As Long) As Boolean
   Dim t As Long
   For t = s To s + dur - 1
       If t > MAX_SHIFT Then LocationOK = False: Exit Function
       If loc = "Alan"  And AlanDolu(t)  >= AlanKap  Then LocationOK = False: Exit Function
       If loc = "Kabin" And KabinDolu(t) >= KabinKap Then LocationOK = False: Exit Function
   Next t
   LocationOK = True
End Function
 
Function AircraftFree(ac As Long, s As Long, dur As Long) As Boolean
   Dim t As Long
   For t = s To s + dur - 1
       If AircraftLoc(ac, t) <> "" Then AircraftFree = False: Exit Function
   Next t
   AircraftFree = True
End Function
 
Function SealantConflict(ac As Long, s As Long, dur As Long) As Boolean
   Dim t As Long
   For t = s To s + dur - 1
       If SealantActive(ac, t) Then SealantConflict = True: Exit Function
   Next t
   SealantConflict = False
End Function
 
Function WorkersOK(op As Long, s As Long, dur As Long, need As Long) As Boolean
   Dim t As Long
   For t = s To s + dur - 1
       If CountFreeWorkers(op, t) < need Then WorkersOK = False: Exit Function
   Next t
   WorkersOK = True
End Function
 
Function CountFreeWorkers(op As Long, shiftNo As Long) As Long
   Dim w As Long, cnt As Long
   For w = 1 To WorkerCount
       If Skill(w, op) And Avail(w, shiftNo) And Not Busy(w, shiftNo) Then cnt = cnt + 1
   Next w
   CountFreeWorkers = cnt
End Function
 
' EQP: 2 vardiya, ayni kisi her iki vardiyada da olmali
Function FindEQPSlot(ac As Long, ByRef sOut As Long, ByRef eOut As Long, ByRef locOut As String) As Boolean
   Dim s As Long, w As Long, p As Long
   Dim loc1 As String, loc2 As String
   Dim patterns(1 To 4, 1 To 2) As String
 
   patterns(1, 1) = "Alan":  patterns(1, 2) = "Kabin"
   patterns(2, 1) = "Alan":  patterns(2, 2) = "Alan"
   patterns(3, 1) = "Kabin": patterns(3, 2) = "Kabin"
   patterns(4, 1) = "Kabin": patterns(4, 2) = "Alan"
 
   For s = ReadyShift(ac) To MAX_SHIFT - 1
       ' Ayni iscinin her iki vardiyada da musait olup olmadigini kontrol et
       Dim eqpWorker As Long: eqpWorker = FindEQPWorker(s)
       If eqpWorker > 0 Then
           For p = 1 To 4
               loc1 = patterns(p, 1): loc2 = patterns(p, 2)
               If EQPLocOK(ac, loc1, s) And EQPLocOK(ac, loc2, s + 1) Then
                   sOut = s: eOut = s + 1: locOut = loc1 & "-" & loc2
                   FindEQPSlot = True: Exit Function
               End If
           Next p
       End If
   Next s
   FindEQPSlot = False
End Function
 
Function FindEQPWorker(s As Long) As Long
   Dim w As Long
   For w = 1 To WorkerCount
       If Skill(w, OP_EQP) And Avail(w, s) And Avail(w, s + 1) And Not Busy(w, s) And Not Busy(w, s + 1) Then
           FindEQPWorker = w: Exit Function
       End If
   Next w
   FindEQPWorker = 0
End Function
 
Function EQPLocOK(ac As Long, loc As String, s As Long) As Boolean
   If AircraftLoc(ac, s) = loc Then EQPLocOK = True: Exit Function
   If AircraftLoc(ac, s) = "" Then
       If loc = "Alan"  And AlanDolu(s)  < AlanKap  Then EQPLocOK = True: Exit Function
       If loc = "Kabin" And KabinDolu(s) < KabinKap Then EQPLocOK = True: Exit Function
   End If
   EQPLocOK = False
End Function
 
