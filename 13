Private Sub WritePlanRow(ucak As String, op As String, loc As String, s As Long, e As Long, workersTxt As String, pr As Long, dueS As Long, tip As String)
   Dim ws As Worksheet: Set ws = ThisWorkbook.Worksheets(WS_PLAN)
 
   ws.Cells(PlanRow, 1).Value = ShiftToDate(s)
   ws.Cells(PlanRow, 1).NumberFormat = "dd.mm.yyyy"
   ws.Cells(PlanRow, 2).Value = ShiftToCode(s)
   ws.Cells(PlanRow, 3).Value = s
   ws.Cells(PlanRow, 4).Value = e
   ws.Cells(PlanRow, 5).Value = ucak
   ws.Cells(PlanRow, 6).Value = op
   ws.Cells(PlanRow, 7).Value = loc
   ws.Cells(PlanRow, 8).Value = e - s + 1
   ws.Cells(PlanRow, 9).Value = workersTxt
   ws.Cells(PlanRow, 10).Value = pr
   ws.Cells(PlanRow, 11).Value = tip
 
   If e <= dueS Then
       ws.Cells(PlanRow, 12).Value = "Zamaninda"
       ws.Cells(PlanRow, 12).Interior.Color = RGB(198, 239, 206)
   Else
       ws.Cells(PlanRow, 12).Value = "GECIKME RISKI!"
       ws.Cells(PlanRow, 12).Interior.Color = RGB(255, 199, 206)
       ws.Cells(PlanRow, 12).Font.Bold = True
       ws.Cells(PlanRow, 12).Font.Color = RGB(192, 0, 0)
   End If
 
   ' Konum rengi
   If loc = "Kabin" Then ws.Cells(PlanRow, 7).Interior.Color = RGB(255, 230, 153)
   If loc = "Alan"  Then ws.Cells(PlanRow, 7).Interior.Color = RGB(198, 239, 206)
 
   ' Gantt için kaydet
   Call AddGanttData(ucak, op, loc, s, e)
 
   PlanRow = PlanRow + 1
End Sub
 
Private Sub AddGanttData(ucak As String, op As String, loc As String, s As Long, e As Long)
   Dim ws As Worksheet: Set ws = ThisWorkbook.Worksheets(WS_GANTT)
   Dim r As Long
   r = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row + 1
   If r < 4 Then r = 4
   ws.Cells(r, 1).Value = ucak
   ws.Cells(r, 2).Value = op
   ws.Cells(r, 3).Value = loc
   ws.Cells(r, 4).Value = s
   ws.Cells(r, 5).Value = e
End Sub
 
' ================================================================
' GANTT FORMAT - 3 SATIRLI BASLIK
' Satir 1: Ay adlari
' Satir 2: dd.mm tarihleri (dikey, her gun 3 kolon birlestir)
' Satir 3: V3 / V1 / V2
' ================================================================
Private Sub FormatGantt()
   Dim ws As Worksheet: Set ws = ThisWorkbook.Worksheets(WS_GANTT)
   Dim dataLast As Long: dataLast = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
   Dim arr As Variant
 
   If dataLast >= 4 Then arr = ws.Range("A4:E" & dataLast).Value
   ws.Cells.Clear
 
   Dim startCol As Long: startCol = GANTT_START_COL
   Dim totShifts As Long: totShifts = GANTT_SHIFTS
 
   ' ── Sol sabit kolonlar (3 satirla birlestir) ──────────────
   Dim fixData(1 To 3) As String
   fixData(1) = "Ucak": fixData(2) = "Islem": fixData(3) = "Konum"
   Dim c As Long
   For c = 1 To 3
       ws.Range(ws.Cells(1, c), ws.Cells(3, c)).Merge
       With ws.Cells(1, c)
           .Value = fixData(c)
           .Interior.Color = RGB(31, 56, 100)
           .Font.Color = vbWhite: .Font.Bold = True: .Font.Name = "Arial": .Font.Size = 10
           .HorizontalAlignment = xlCenter: .VerticalAlignment = xlCenter
       End With
   Next c
 
   ' ── SATIR 1: Ay adlari ───────────────────────────────────
   Dim s As Long, mName As String, curMonth As String, mStart As Long
   curMonth = "": mStart = startCol
   For s = 1 To totShifts
       mName = UCase(Format(ShiftToDate(s), "mmmm")) & " " & Year(ShiftToDate(s))
       c = startCol + s - 1
       If curMonth = "" Then curMonth = mName: mStart = c
       If mName <> curMonth Or s = totShifts Then
           Dim mEnd As Long
           mEnd = IIf(s = totShifts And mName = curMonth, c, c - 1)
           ws.Range(ws.Cells(1, mStart), ws.Cells(1, mEnd)).Merge
           With ws.Cells(1, mStart)
               .Value = curMonth
               .Interior.Color = RGB(31, 56, 100)
               .Font.Color = vbWhite: .Font.Bold = True: .Font.Name = "Arial": .Font.Size = 10
               .HorizontalAlignment = xlCenter: .VerticalAlignment = xlCenter
           End With
           curMonth = mName: mStart = c
       End If
   Next s
 
   ' ── SATIR 2: Gunluk tarihler (her gun 3 kolon birlestir) ──
   Dim dayIdx As Long, colS As Long, colE As Long, dVal As Date
   For dayIdx = 0 To (totShifts - 1) \ 3
       colS = startCol + dayIdx * 3
       colE = Application.WorksheetFunction.Min(colS + 2, startCol + totShifts - 1)
       dVal = DateAdd("d", dayIdx, RefDate)
       ws.Range(ws.Cells(2, colS), ws.Cells(2, colE)).Merge
       With ws.Cells(2, colS)
           .Value = Format(dVal, "dd.mm")
           .Orientation = 90
           .HorizontalAlignment = xlCenter: .VerticalAlignment = xlCenter
           .Font.Bold = True: .Font.Name = "Arial": .Font.Size = 8
           .Interior.Color = IIf(dayIdx Mod 2 = 0, RGB(46, 117, 182), RGB(68, 114, 196))
           .Font.Color = vbWhite
       End With
   Next dayIdx
 
   ' ── SATIR 3: V3 / V1 / V2 ────────────────────────────────
   Dim vLabels(1 To 3) As String: vLabels(1) = "V3": vLabels(2) = "V1": vLabels(3) = "V2"
   Dim vColors(1 To 3) As Long
   vColors(1) = RGB(46, 117, 182): vColors(2) = RGB(68, 114, 196): vColors(3) = RGB(91, 155, 213)
   For s = 1 To totShifts
       c = startCol + s - 1
       Dim vi As Long: vi = ((s - 1) Mod 3) + 1
       With ws.Cells(3, c)
           .Value = vLabels(vi)
           .Interior.Color = vColors(vi)
           .Font.Color = vbWhite: .Font.Bold = True: .Font.Name = "Arial": .Font.Size = 7
           .HorizontalAlignment = xlCenter: .VerticalAlignment = xlCenter
       End With
   Next s
 
   ' ── Satir yukseklikleri ───────────────────────────────────
   ws.Rows(1).RowHeight = 22
   ws.Rows(2).RowHeight = 55
   ws.Rows(3).RowHeight = 16
 
   ' ── Veri satirlari ───────────────────────────────────────
   If IsEmpty(arr) Then GoTo Bitir
 
   Dim outR As Long: outR = 4
   Dim r As Long, ucak As String, op As String, loc As String, st As Long, en As Long
   For r = 1 To UBound(arr, 1)
       ucak = CStr(arr(r, 1)): op = CStr(arr(r, 2))
       loc  = CStr(arr(r, 3))
       
       ' st ve en icin guvenli donusum
       If IsNumeric(arr(r, 4)) Then st = CLng(arr(r, 4)) Else st = 1
       If IsNumeric(arr(r, 5)) Then en = CLng(arr(r, 5)) Else en = st
 
       ws.Cells(outR, 1).Value = ucak
       ws.Cells(outR, 2).Value = op
       ws.Cells(outR, 3).Value = loc
 
       For s = st To en
           If s <= totShifts Then
               c = startCol + s - 1
               Dim cv As String
               If loc = "Kabin" Then cv = "K"
               If loc = "Alan"  Then cv = "A"
               If loc = "-"     Then cv = "S"
               If InStr(loc, "->") > 0 Then cv = "E"
               ws.Cells(outR, c).Value = cv
               ws.Cells(outR, c).Interior.Color = AircraftColor(ucak, op)
               ws.Cells(outR, c).Font.Color = vbWhite
               ws.Cells(outR, c).Font.Bold = True
               ws.Cells(outR, c).Font.Size = 7
               ws.Cells(outR, c).HorizontalAlignment = xlCenter
           End If
       Next s
       ws.Rows(outR).RowHeight = 16
       outR = outR + 1
   Next r
 
Bitir:
   ' Sutun genislikleri
   ws.Columns(1).ColumnWidth = 10
   ws.Columns(2).ColumnWidth = 14
   ws.Columns(3).ColumnWidth = 8
   For c = startCol To startCol + totShifts - 1
       ws.Columns(c).ColumnWidth = 3.2
   Next c
 
   ' Dondur: ucak/islem/konum sabit kalsin
   ws.Activate
   ActiveWindow.FreezePanes = False
   ws.Cells(4, startCol).Select
   ActiveWindow.FreezePanes = True
End Sub
 
