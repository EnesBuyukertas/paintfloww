Function AyAdindanNo(ayAdi As String) As Long
   Dim a As String: a = UCase(Trim(ayAdi))
   ' Turkce normalize
   a = Replace(a, Chr(305), "I"): a = Replace(a, Chr(350), "S")
   a = Replace(a, Chr(220), "U"): a = Replace(a, Chr(214), "O")
   a = Replace(a, Chr(199), "C"): a = Replace(a, Chr(286), "G")
 
   Select Case Left(a, 3)
       Case "OCA": AyAdindanNo = 1
       Case "SUB", "ŞUB": AyAdindanNo = 2
       Case "MAR": AyAdindanNo = 3
       Case "NIS": AyAdindanNo = 4
       Case "MAY": AyAdindanNo = 5
       Case "HAZ": AyAdindanNo = 6
       Case "TEM": AyAdindanNo = 7
       Case "AGU", "AĞU": AyAdindanNo = 8
       Case "EYL": AyAdindanNo = 9
       Case "EKI", "EKİ": AyAdindanNo = 10
       Case "KAS": AyAdindanNo = 11
       Case "ARA": AyAdindanNo = 12
       Case Else:  AyAdindanNo = 0
   End Select
End Function
 
